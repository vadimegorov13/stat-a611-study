{
  "name": "stat-a611-study-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Local study workspace for STAT A611 built on the study-content pack.",
  "scripts": {
    "start": "npm run build && npm run serve",
    "serve": "NODE_ENV=production tsx server/index.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:content": "tsx scripts/check-content.ts && python3 scripts/verify_answers.py"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "diff": "^7.0.0",
    "express": "^4.21.2",
    "katex": "^0.16.11",
    "minisearch": "^7.1.1",
    "pdfjs-dist": "^4.8.69",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-resizable-panels": "^2.1.7",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/diff": "^6.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
